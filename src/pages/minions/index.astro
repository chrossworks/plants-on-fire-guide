---
import { listedForms } from '../../../lib/forms.mjs';
import { evaluationLabel } from '../../../lib/rumble.mjs';
import Layout from '../../layouts/Layout.astro';
import { sortedMinions, imageUrl, minionUrl, updates, url } from '../../lib/site';
import { rarityLabels } from '../../../lib/schema.mjs';
const minions = listedForms(sortedMinions());
const pending=updates.flatMap(update=>update.changes.filter(c=>c.type==='addition'&&c.target.kind==='minion'&&!minions.some(m=>m.id===c.target.minionId)).map(c=>({...c,update})));
---
<Layout title="ミニオン一覧"><p class="eyebrow">MINIONS</p><h1>ミニオン一覧</h1><p class="lede">レアリティ・コスト・評価から、編成の候補を探せます。</p>
<section class="pending-addition" aria-label="新規追加ミニオン">{pending.length>0 && <><h2>新しく追加されたミニオン</h2><ul>{pending.map(c=><li><a href={url('updates/'+c.update.id+'/#'+c.id)}>{c.target.name}</a> — 実装日：{c.introduced?.value || '未確認'}／詳細性能は確認中</li>)}</ul></>}</section>
<form class="filters" id="filters"><label>名前<input id="name" type="search" placeholder="ミニオン名" /></label><label>レアリティ<select id="rarity"><option value="">すべて</option><option value="legend">レジェンド</option><option value="epic">エピック</option><option value="rare">レア</option></select></label><label>コスト<select id="cost"><option value="">すべて</option>{[...new Set(minions.map(m=>m.cost.value))].sort((a,b)=>a-b).map(c=><option value={c}>{c}</option>)}</select></label><label>評価モード<select id="mode"><option value="standard">通常（ランクマッチ）</option><option value="rumble">ランブルチェス</option></select></label><label>評価<select id="rank"><option value="">すべて</option>{['SS','S','A','B','C','未評価','未確認','対象外'].map(r=><option value={r}>{r === '対象外' ? '-（対象外）' : r}</option>)}</select></label><label>並び順<select id="sort"><option value="default">レアリティ・コスト・名前</option><option value="cost">コストの低い順</option><option value="rank">評価順</option><option value="name">名前順</option></select></label><button type="reset">条件をクリア</button></form>
<p id="count" aria-live="polite" class="muted">{minions.length}形態</p><div class="table-wrap"><table class="minion-list"><thead><tr><th scope="col">アイコン</th><th scope="col">レアリティ</th><th scope="col">コスト</th><th scope="col">名前</th><th scope="col">評価</th></tr></thead><tbody id="rows">{minions.map((m,i)=><tr data-name={m.name} data-reading={m.reading} data-rarity={m.rarity.value} data-cost={m.cost.value} data-rank={m.evaluation.rank} data-standard={m.evaluations.standard.rank} data-rumble={m.evaluations['rumble-chess'].rank} data-standard-pending={Boolean(m.evaluations.standard.pendingUpdate)} data-rumble-pending={Boolean(m.evaluations['rumble-chess'].pendingUpdate)} data-index={i}><td>{m.icon ? <img src={imageUrl(m.icon)} alt="" width="64" height="64"/> : <span class="muted">準備中</span>}</td><td>{rarityLabels[m.rarity.value]}</td><td>{m.cost.value}</td><th scope="row"><a href={minionUrl(m.id)}>{m.name}</a>{m.availability?.ranked.value === false && <small class="tag">ランクマッチ使用不可</small>}</th><td><strong class="rating list-rating">{evaluationLabel(m.evaluation.rank)}</strong><small class="muted list-pending" hidden={!m.evaluation.pendingUpdate}> 調整前の評価</small></td></tr>)}</tbody></table></div><p id="empty" hidden>条件に合うミニオンはありません。</p><p class="muted">評価は選択した形態・モードの攻略判断です。未評価・未確認・対象外を区別し、以前の評価を自動適用していません。アイコン内のLvは撮影時の表示であり、掲載性能の基準ではありません。</p>
</Layout>
<script>
const form = document.querySelector<HTMLFormElement>('#filters')!;
const rows = [...document.querySelectorAll<HTMLTableRowElement>('#rows tr')];
const value = (id:string) => document.querySelector<HTMLInputElement|HTMLSelectElement>(`#${id}`)!.value;
function update() {
  const query=value('name').trim().normalize('NFKC').toLowerCase(); let count=0;
  for(const row of rows){const d=row.dataset;d.rank=d[value('mode')];row.querySelector('.list-rating')!.textContent=d.rank==='対象外'?'-':d.rank!;row.querySelector<HTMLElement>('.list-pending')!.hidden=d[value('mode')+'Pending']!=='true';row.hidden=!( (!query || (d.name+d.reading).normalize('NFKC').toLowerCase().includes(query)) && ['rarity','cost','rank'].every(k=>!value(k)||value(k)===d[k]) ); if(!row.hidden)count++;}
  const ranks=['SS','S','A','B','C','未評価','未確認','対象外'];
  rows.sort((a,b)=>{const x=a.dataset,y=b.dataset;return (value('sort')==='cost'?Number(x.cost)-Number(y.cost):value('sort')==='rank'?ranks.indexOf(x.rank!)-ranks.indexOf(y.rank!):value('sort')==='name'?x.reading!.localeCompare(y.reading!,'ja'):0)||Number(x.index)-Number(y.index)});
  document.querySelector('#rows')!.append(...rows); document.querySelector('#count')!.textContent=`${count}形態`; document.querySelector<HTMLElement>('#empty')!.hidden=count!==0;
}
form.addEventListener('input',update);form.addEventListener('change',update);form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',()=>setTimeout(update,0));
</script>
