---
import Layout from '../../layouts/Layout.astro';
import { sortedMinions, imageUrl, minionUrl } from '../../lib/site';
import { rarityLabels } from '../../../lib/schema.mjs';
const minions = sortedMinions();
---
<Layout title="ミニオン一覧"><p class="eyebrow">MINIONS</p><h1>ミニオン一覧</h1><p class="lede">レアリティ・コスト・評価から、編成の候補を探せます。</p>
<form class="filters" id="filters"><label>名前<input id="name" type="search" placeholder="ミニオン名" /></label><label>レアリティ<select id="rarity"><option value="">すべて</option><option value="legend">レジェンド</option><option value="epic">エピック</option><option value="rare">レア</option></select></label><label>コスト<select id="cost"><option value="">すべて</option>{[...new Set(minions.map(m=>m.cost.value))].sort((a,b)=>a-b).map(c=><option value={c}>{c}</option>)}</select></label><label>評価<select id="rank"><option value="">すべて</option>{['SS','S','A','B','C','未評価'].map(r=><option>{r}</option>)}</select></label><label>並び順<select id="sort"><option value="default">レアリティ・コスト・名前</option><option value="cost">コストの低い順</option><option value="rank">評価順</option><option value="name">名前順</option></select></label><button type="reset">条件をクリア</button></form>
<p id="count" aria-live="polite" class="muted">{minions.length}体</p><div class="table-wrap"><table class="minion-list"><thead><tr><th scope="col">アイコン</th><th scope="col">レアリティ</th><th scope="col">コスト</th><th scope="col">名前</th><th scope="col">評価</th></tr></thead><tbody id="rows">{minions.map((m,i)=><tr data-name={m.name} data-reading={m.reading} data-rarity={m.rarity.value} data-cost={m.cost.value} data-rank={m.evaluation.rank} data-index={i}><td><img src={imageUrl(m.icon)} alt="" width="64" height="64"/></td><td>{rarityLabels[m.rarity.value]}</td><td>{m.cost.value}</td><th scope="row"><a href={minionUrl(m.id)}>{m.name}</a></th><td><strong class="rating">{m.evaluation.rank}</strong></td></tr>)}</tbody></table></div><p id="empty" hidden>条件に合うミニオンはありません。</p><p class="muted">評価は運営者の攻略判断です。アイコン内のLvは撮影時の表示であり、掲載性能の基準ではありません。</p>
</Layout>
<script>
const form = document.querySelector<HTMLFormElement>('#filters')!;
const rows = [...document.querySelectorAll<HTMLTableRowElement>('#rows tr')];
const value = (id:string) => document.querySelector<HTMLInputElement|HTMLSelectElement>(`#${id}`)!.value;
function update() {
  const query=value('name').trim().normalize('NFKC').toLowerCase(); let count=0;
  for(const row of rows){const d=row.dataset;row.hidden=!( (!query || (d.name+d.reading).normalize('NFKC').toLowerCase().includes(query)) && ['rarity','cost','rank'].every(k=>!value(k)||value(k)===d[k]) ); if(!row.hidden)count++;}
  const ranks=['SS','S','A','B','C','未評価'];
  rows.sort((a,b)=>{const x=a.dataset,y=b.dataset;return (value('sort')==='cost'?Number(x.cost)-Number(y.cost):value('sort')==='rank'?ranks.indexOf(x.rank!)-ranks.indexOf(y.rank!):value('sort')==='name'?x.reading!.localeCompare(y.reading!,'ja'):0)||Number(x.index)-Number(y.index)});
  document.querySelector('#rows')!.append(...rows); document.querySelector('#count')!.textContent=`${count}体`; document.querySelector<HTMLElement>('#empty')!.hidden=count!==0;
}
form.addEventListener('input',update);form.addEventListener('change',update);form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',()=>setTimeout(update,0));
</script>
