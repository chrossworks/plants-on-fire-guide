---
import Fact from './Fact.astro';
import { imageUrl } from '../lib/site';
const { entry, rules } = Astro.props;
const star4 = entry.star4?.value;
---
<section id="rumble-chess" class="form-section">
  <h2>ランブルチェス</h2>
  {entry.availability.value === false ? <p>ランブルチェスには登場しません。星4能力・絆は対象外です。</p>
    : entry.availability.value !== true ? <p>ランブルチェスへの登場は未確認です。</p>
    : <>
      <p class="bond-label"><span>絆：</span>{entry.deck?.bond.icon?.value && <img src={imageUrl(entry.deck.bond.icon.value)} alt="" width="32" height="32" loading="lazy"/>}{entry.deck ? <Fact fact={entry.deck.bond.name}/> : '未確認'}</p>
      <h3>★★★★の能力</h3>
      {star4 ? <><p><Fact fact={{...entry.star4, value:star4.ability}}/></p><p class="condition">{star4.conditions}</p></> : <p>星4の能力は未確認です。</p>}
      <p class="muted">攻撃力・星1〜3の能力は同じレベルの基本性能と共通です。{rules.minimumGuaranteedLevel.value && <>ランブルチェスでは最低Lv.{rules.minimumGuaranteedLevel.value}が保証されます。</>}</p>
    </>}
</section>
<style>
  .bond-label { display: flex; align-items: center; gap: .4rem; }
  .bond-label img { width: 32px; height: 32px; flex-shrink: 0; border-radius: 50%; }
</style>
