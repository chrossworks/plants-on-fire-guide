---
import Fact from './Fact.astro';
import { assets, imageUrl } from '../lib/site';
import { basePerformance } from '../../lib/performance.mjs';
const { form, minimumLevel, variant = false } = Astro.props;
const display = basePerformance(form);
---
<section id={form.id} class="form-section">
  <div class="section-heading"><h2>{form.name}</h2>{variant && <span class="tag">カードランク <Fact fact={form.cardRank} /></span>}</div>
  {form.image && <img class="variant-image" src={imageUrl(form.image)} alt={assets[form.image].alt} loading="lazy" width="560" height="543" />}
  {display.fallback.length > 0 && <p class="condition">{display.fallback.join('・')}は最低レベルの性能が未確認のため、以下の撮影時の値を掲載しています。<br /><strong>詳細画面の表示：Lv.<Fact fact={form.displayLevel} /></strong><br />{form.conditions}</p>}
  <div class="table-wrap"><table class="performance"><caption>{`星ごとの性能（最低レベル${minimumLevel ? `：Lv.${minimumLevel}` : ''}${display.fallback.length?'・未確認項目は撮影時の値':''}）`}</caption><thead><tr><th scope="col">星</th><th scope="col">攻撃力</th><th scope="col">攻撃間隔</th><th scope="col">攻撃対象</th><th scope="col">能力</th></tr></thead><tbody>
    {display.stars.map(s=><tr><th scope="row">{'★'.repeat(s.star)}</th><td><Fact fact={s.stats.attack} showDerivation={false}/></td><td><Fact fact={s.stats.interval} suffix="秒"/></td><td><Fact fact={s.stats.target}/></td><td class="ability"><Fact fact={s.ability} showDerivation={false}/></td></tr>)}
  </tbody></table></div>
  <h3>Lvボーナス</h3>
  {form.bonuses.length ? <div class="table-wrap"><table><thead><tr><th scope="col">到達Lv</th><th scope="col">変更内容</th></tr></thead><tbody>{form.bonuses.map(b=><tr><th scope="row">Lv.{b.level}</th><td><Fact fact={b.effect}/></td></tr>)}</tbody></table></div> : <p>Lvボーナスは未確認です。</p>}
  {form.bonusCoverage.status==='unknown' && <p class="muted">一覧の収録範囲：未確認（{form.bonusCoverage.reason}）</p>}
  <p>入手方法：<Fact fact={form.acquisition}/></p>
</section>
